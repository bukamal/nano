<?xml version="1.0" encoding="utf-8"?>
<!--
  PHASE10 home screen widget sizing/refresh metadata.

  updatePeriodMillis=1800000 (30 min) is Android's *minimum-guaranteed*
  floor for this mechanism (the OS clamps anything lower to 30 min anyway,
  per the AppWidgetProviderInfo docs) and is only the
  closed-app safety net; the periodic WorkManager pass in
  native_files.dart's _pushHomeWidgetSnapshot is what actually drives it,
  same as PHASE9's notification check. The instant push_home_widget path
  (app open, right after a sale/voucher save) is what keeps it feeling live
  the rest of the time.

  Lock screen (Glanceable Hub, Android 16 QPR1+): no change needed here.
  That surface uses an opt-OUT model; every widget is eligible by
  default unless android:widgetCategory explicitly includes
  "not_keyguard". The older Android 4.2-5.0 keyguard widget API
  (widgetCategory="keyguard" + initialKeyguardLayout) is deprecated and
  irrelevant to Glance-based widgets like this one, which has no
  res/layout to point a keyguard layout at.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:previewImage="@drawable/nano_widget_preview"
    android:description="@string/nano_widget_description" />
