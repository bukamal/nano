<?xml version="1.0" encoding="utf-8"?>
<!--
  PHASE10 home screen widget sizing/refresh metadata.

  updatePeriodMin=30 is Android's *minimum-guaranteed* floor for this
  mechanism (the OS clamps anything lower to 30 anyway) and is only the
  closed-app safety net; the periodic WorkManager pass in
  native_files.dart's _pushHomeWidgetSnapshot is what actually drives it,
  same as PHASE9's notification check. The instant push_home_widget path
  (app open, right after a sale/voucher save) is what keeps it feeling live
  the rest of the time.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMin="30"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
