<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.nano.homewidget">

    <!-- Voice commands: on-device SpeechRecognizer -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Shared SQLite directory (Documents/NanoShared) across suite APKs -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!--
      NOTE: Do NOT declare a custom <permission android:name="com.nano.permission...">
      here. Defining the same custom permission in multiple APKs causes
      INSTALL_FAILED_DUPLICATE_PERMISSION / "App not installed" when installing
      the 2nd suite package. Shared DB uses the public Documents path instead.
    -->

    <application>
        <receiver
            android:name="com.nano.homewidget.NanoWidgetReceiver"
            android:exported="true"
            android:label="Nano | نانو">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nano_widget_info" />
        </receiver>

        <service
            android:name="com.nano.homewidget.NanoQuickSettingsTileService"
            android:exported="true"
            android:icon="@drawable/ic_nano_tile"
            android:label="نانو"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
          Provider is NOT exported. Cross-app DB sharing uses Documents/NanoShared.
          exported=true + a shared custom permission previously blocked installing
          a second suite APK on the same device.
        -->
        <provider
            android:name="com.nano.shared.NanoSharedDbProvider"
            android:authorities="${applicationId}.shared.db"
            android:exported="false"
            android:grantUriPermissions="false" />
    </application>

</manifest>
