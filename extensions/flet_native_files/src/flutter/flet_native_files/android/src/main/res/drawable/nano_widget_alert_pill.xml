<?xml version="1.0" encoding="utf-8"?>
<!--
  FIX_0.9.2: soft pill background for the alert row. Same family as the
  card background (#FFD9C2 alert text on a faint amber-tinted surface) so
  the alert reads as "soft warning" rather than a flat block.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="10dp" />
    <solid android:color="#26FFD9C2" />
    <stroke
        android:width="0.5dp"
        android:color="#66FFD9C2" />
</shape>
