<?xml version="1.0" encoding="utf-8"?>
<!--
  FIX_0.9.1: home-screen widget layout, rendered by NanoWidgetReceiver via
  plain RemoteViews (no Glance/Compose). Only framework-supported views and
  a shape drawable background. Safe for RemoteViews. Renders RTL
  automatically on Arabic locales (LinearLayout is direction-aware).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nano_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nano_widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/nano_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nano | نانو"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مبيعات اليوم"
                android:textColor="#C7E5E0"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/nano_widget_sales_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="رصيد الصندوق"
                android:textColor="#C7E5E0"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/nano_widget_cash_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/nano_widget_alert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#FFD9C2"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/nano_widget_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="افتح التطبيق للتحديث"
        android:textColor="#C7E5E0"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
