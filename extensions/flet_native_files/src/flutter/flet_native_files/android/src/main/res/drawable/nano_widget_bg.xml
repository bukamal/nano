<?xml version="1.0" encoding="utf-8"?>
<!--
  FIX_0.9.3: refined card background — deeper teal gradient for contrast
  with white KPI text, 20dp corners and a 1dp translucent white hairline
  stroke so the card separates cleanly from any wallpaper (RemoteViews
  cannot render elevation shadows, so the stroke does that job).
  Palette stays inside Nano's theme (theme.py: PRIMARY #0F766E,
  PRIMARY_DARK #115E59, deep end #134E4A).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />
    <gradient
        android:angle="135"
        android:endColor="#134E4A"
        android:startColor="#0F766E"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
</shape>
