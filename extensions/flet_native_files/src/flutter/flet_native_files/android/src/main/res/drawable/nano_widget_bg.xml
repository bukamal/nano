<?xml version="1.0" encoding="utf-8"?>
<!--
  FIX_0.9.2: brand teal gradient background (theme.py PRIMARY → PRIMARY_DARK)
  with 16dp rounded corners. Shape drawables with <gradient> are
  RemoteViews-safe since API 1. The bottom-right subtle brightening creates
  a "card lifts off the wallpaper" effect without needing elevation or
  Material shadows (which RemoteViews can't render anyway).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <gradient
        android:angle="135"
        android:endColor="#115E59"
        android:startColor="#0F766E"
        android:type="linear" />
</shape>
